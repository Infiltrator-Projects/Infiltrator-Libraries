{
  "schema": "infiltrator-design-v1",
  "reference_implementation": "MBLINK",
  "typography": {
    "ui_family": "MB Corpo S Title WEB",
    "brand_family": "MB Corpo A Title Cond WEB",
    "ui_regular_weight": 400,
    "ui_bold_weight": 700,
    "brand_weight": 400,
    "font_files": {
      "brand_regular": "mb_corpo_a_cond_regular.ttf",
      "ui_bold": "mb_corpo_s_bold.ttf",
      "ui_regular": "mb_corpo_s_regular.ttf"
    },
    "fallbacks": {
      "gtk": "Sans",
      "web": "sans-serif",
      "apple": "system",
      "windows": "Segoe UI",
      "tk": "TkDefaultFont"
    },
    "roles": {
      "body": {
        "family": "ui",
        "weight": 400
      },
      "body_emphasis": {
        "family": "ui",
        "weight": 700
      },
      "button": {
        "family": "ui",
        "weight": 700
      },
      "section_title": {
        "family": "ui",
        "weight": 700
      },
      "brand_title": {
        "family": "brand",
        "weight": 400
      },
      "caption": {
        "family": "ui",
        "weight": 400
      },
      "caption_emphasis": {
        "family": "ui",
        "weight": 700
      },
      "technical_text": {
        "family": "ui",
        "weight": 400
      }
    }
  },
  "palette": {
    "background": "#050608",
    "panel": "#101318",
    "card": "#171B20",
    "surface": "#0D1014",
    "input": "#0E1115",
    "border": "#353A40",
    "text": "#E8ECEF",
    "title": "#EEF1F3",
    "muted": "#AEB6BD",
    "subtle": "#899198",
    "button_background": "#D7DDE2",
    "button_foreground": "#111418",
    "selection_background": "#2B3137",
    "selection_foreground": "#EEF1F3",
    "neutral_accent": "#00ADEF",
    "success": "#63AB7C",
    "warning": "#D19E47",
    "fault": "#C96B6B",
    "info": "#7FA7C9"
  },
  "metrics": {
    "small_radius": 6,
    "control_radius": 10,
    "card_radius": 12,
    "panel_radius": 18,
    "compact_spacing": 6,
    "control_spacing": 10,
    "section_spacing": 18,
    "content_padding": 16,
    "screen_padding": 20
  },
  "policy": {
    "product_accent_is_local": true,
    "product_icons_are_local": true,
    "manufacturer_branding_is_local": true,
    "font_binaries_are_not_part_of_this_contract": true,
    "owned_graphical_ui_uses_mb_corpo_when_available": true,
    "fallback_is_required_when_mb_corpo_is_unavailable": true,
    "theme_contract_is_product_neutral": true,
    "system_theme_is_platform_authoritative": true
  },
  "theme": {
    "contract_version": 1,
    "modes": [
      "system",
      "day",
      "night"
    ],
    "default_mode": "system",
    "system_policy": "platform_authoritative",
    "system_resolution": "platform adapter resolves current light/dark preference; Common provides no third system palette",
    "palettes": {
      "day": {
        "background": "#FFFFFF",
        "panel": "#FFFFFF",
        "card": "#F8F9FA",
        "surface": "#ECEFF2",
        "input": "#FFFFFF",
        "border": "#C7CDD3",
        "text": "#20252B",
        "title": "#111418",
        "muted": "#59636C",
        "subtle": "#737D86",
        "button_background": "#20252B",
        "button_foreground": "#FFFFFF",
        "selection_background": "#DDE2E7",
        "selection_foreground": "#111418",
        "neutral_accent": "#00ADEF",
        "success": "#3A8A58",
        "warning": "#9A6500",
        "fault": "#B54848",
        "info": "#467AA3",
        "operation": "#E8ECEF",
        "card_hover": "#EEF1F3",
        "surface_hover": "#F1F3F5",
        "operation_hover": "#DDE2E7",
        "equals_hover": "#343B42"
      },
      "night": {
        "background": "#050608",
        "panel": "#101318",
        "card": "#171B20",
        "surface": "#0D1014",
        "input": "#0E1115",
        "border": "#353A40",
        "text": "#E8ECEF",
        "title": "#EEF1F3",
        "muted": "#AEB6BD",
        "subtle": "#899198",
        "button_background": "#D7DDE2",
        "button_foreground": "#111418",
        "selection_background": "#2B3137",
        "selection_foreground": "#EEF1F3",
        "neutral_accent": "#00ADEF",
        "success": "#63AB7C",
        "warning": "#D19E47",
        "fault": "#C96B6B",
        "info": "#7FA7C9",
        "operation": "#20252B",
        "card_hover": "#22272D",
        "surface_hover": "#171B20",
        "operation_hover": "#2B3137",
        "equals_hover": "#EEF1F3"
      }
    },
    "compatibility": {
      "top_level_palette": "legacy alias of theme.palettes.night for pre-theme consumers",
      "root_web_variables": "remain night by default until a consumer explicitly opts into a theme mode"
    }
  }
}
